# ─── Aether ───────────────────────────────────────────────────────────────────
# Default chat mode is Aether Cloud (hosted): server-side keys below.
# Users can still Bring Your Own Key in Settings (browser localStorage).
# Auth + Google Drive + cloud conversation history need server env vars below.

# ─── Aether Cloud (hosted models) ─────────────────────────────────────────────
# Keys stay on the server — never sent to the browser.
#
# Recommended: OpenRouter (long-tail + failover) + one BUZZ token (Claude + ChatGPT).
# OPENROUTER_API_KEY=sk-or-v1-...
#
# BUZZ — https://buzzai.cc/auth?action=register → Tokens → Create Token
# Dashboard shows endpoint https://api.buzzai.cc (we append /v1 automatically).
# AETHER_HOSTED_BUZZ_API_KEY=
# AETHER_HOSTED_BUZZ_BASE_URL=https://api.buzzai.cc/v1
#
# Legacy aliases (same BUZZ key): AETHER_HOSTED_CLAUDE_API_KEY / _BASE_URL
# Optional separate ChatGPT override: AETHER_HOSTED_CHATGPT_API_KEY / _BASE_URL
#
# Optional OpenAI-compatible relays tried AFTER BUZZ and BEFORE OpenRouter
# when the primary is saturated (429). Up to 5; each needs BASE_URL + API_KEY.
# AETHER_HOSTED_RELAY_1_BASE_URL=https://your-relay.example/v1
# AETHER_HOSTED_RELAY_1_API_KEY=
# AETHER_HOSTED_RELAY_1_NAME=relay-a
# AETHER_HOSTED_RELAY_2_BASE_URL=
# AETHER_HOSTED_RELAY_2_API_KEY=
#
# Failover order for Claude/ChatGPT: BUZZ → relays → OpenRouter.
# Without BUZZ, Claude/ChatGPT still work via OpenRouter when OPENROUTER_API_KEY is set.

# Legacy / optional client hints (BYOK still uses Settings UI):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# NEXT_PUBLIC_DEFAULT_MODEL=claude-sonnet-4

# ─── Cloud conversation history (Postgres) ────────────────────────────────────
# Neon (recommended on Vercel): https://neon.tech → connection string
# When set, signed-in users sync chats to the server (Claude/ChatGPT-class).
# Signed-out users still use browser localStorage.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
#
# Local/dev without Neon: embed PGlite (writes ./.data/aether-pglite)
# AETHER_PGLITE=1

# ─── Web search providers (first configured wins; users never see names) ──────
# Prefer research providers when available; Brave is excellent default SERP.
# Free tiers: https://brave.com/search/api/ · https://exa.ai · https://tavily.com
# BRAVE_SEARCH_API_KEY=
# EXA_API_KEY=
# TAVILY_API_KEY=
# Optional force order tip: AETHER_SEARCH_PROVIDER=brave|exa|tavily
# AETHER_SEARCH_PROVIDER=
#
# Without API keys, search falls back to DuckDuckGo HTML + Wikipedia (keyless).

# ─── Browser / computer-use (optional, agent-class portals) ───────────────────
# Browserless headless Chrome for JS-heavy pages. Without this, browser_* tools
# use public fetch only and never auto-submit (confirmation required).
# BROWSERLESS_TOKEN=
# BROWSERLESS_URL=https://chrome.browserless.io

# ─── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Required for production sign-in. Local/harness falls back to a shared
# development secret if unset (see src/lib/auth-secret.ts). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# App URL (set in production / Vercel)
# AUTH_URL=http://localhost:3000

# Google OAuth (sign-in + Drive connect)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/drive/callback
#   https://YOUR_DOMAIN/api/auth/callback/google
#   https://YOUR_DOMAIN/api/drive/callback
# Enable: Google Drive API (Picker API not required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Aliases also accepted: AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET

# GitHub OAuth (sign-in + Connect GitHub connector)
# Create at https://github.com/settings/developers → OAuth Apps
# Authorization callback URL can be the auth one; ALSO add (or use Homepage +):
#   http://localhost:3000/api/auth/callback/github
#   http://localhost:3000/api/github/callback
#   https://YOUR_DOMAIN/api/auth/callback/github
#   https://YOUR_DOMAIN/api/github/callback
# Connector scopes requested at connect time: repo, read:user
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Aliases: AUTH_GITHUB_ID / AUTH_GITHUB_SECRET

# Sign in with Apple (optional — requires Apple Developer Program)
# Create a Services ID + key, then generate a client secret JWT.
# APPLE_ID=
# APPLE_SECRET=
# Aliases: AUTH_APPLE_ID / AUTH_APPLE_SECRET

# Email magic links via Resend — https://resend.com
# Without AUTH_RESEND_KEY, local / harness returns the magic link in the API response.
AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM="Aether <onboarding@resend.dev>"
# Set to 1 on preview / cloud harness deploys to return magic links without Resend.
# Never enable on a public production domain.
# AUTH_ALLOW_DEV_MAGIC_LINK=1

# ─── Remote Hermes agent (hosted live path) ───────────────────────────────────
# Always-on Hermes gateway YOU operate (VPS / Fly / Railway / Docker). Users never
# install Hermes; the browser never talks to it. When set, hosted /api/chat proxies
# to Hermes `/v1/chat/completions` (model + provider) and streams UIMessage events
# back. BYOK still uses the isolated in-process tool loop on Vercel (user keys
# never go to Hermes). If unset, hosted falls back to OPENROUTER / BUZZ keys.
# Railway trial/free-tier: follow deploy/hermes/README.md, then set
# HERMES_BASE_URL to the Railway HTTPS origin (no trailing slash) and
# HERMES_API_KEY to the same value as Railway API_SERVER_KEY.
# HERMES_BASE_URL=https://hermes.example.com
# HERMES_API_KEY=change-me-server-only
# Optional advertised / default model field (Hermes profile name):
# HERMES_MODEL_NAME=hermes-agent
# Optional override for the Hermes provider slug (wins for every hosted turn).
# Default hosted routing: ChatGPT + Claude → custom:buzz; other models → openrouter.
# Bare model without provider is ignored unless Hermes has direct_model_requests.
# HERMES_PROVIDER=openrouter
# Force disable even if URL+key are present:
# HERMES_ENABLED=0
