# Railway-side variables for the remote gateway host.
# No secrets belong in git. Generate API_SERVER_KEY locally.

# ── Required (official API server) ──────────────────────────────────────────
# https://hermes-agent.nousresearch.com/docs/user-guide/features/api-server
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0

# Bearer key. Official docs: minimum 8 characters. The published image's
# startup guard refuses keys shorter than 16. Generate:
#   openssl rand -hex 32
API_SERVER_KEY=

# ── Port / Railway PORT ─────────────────────────────────────────────────────
# Hermes listens on API_SERVER_PORT (default 8642).
# Railway injects PORT and uses it for public routing + healthchecks.
# This image maps API_SERVER_PORT=${PORT:-8642} in railway-cmd.sh
# (and in s6 cont-init 00-aether-port.sh) so you do not need a startCommand.
#
# Alternative if you pin the documented port instead of mapping PORT:
#   PORT=8642
#   API_SERVER_PORT=8642
# and set the Railway domain target port to 8642.
# API_SERVER_PORT=8642
# PORT=8642

# ── Model path (Hermes → OpenRouter) ────────────────────────────────────────
# Same key family Aether Cloud already uses. Hermes reads this from the
# container environment (overrides /opt/data/.env).
# https://hermes-agent.nousresearch.com/docs/integrations/providers
OPENROUTER_API_KEY=

# Preferred upstream for hosted ChatGPT and Claude (OpenAI-compatible).
# Aether sends provider `custom:buzz` (Hermes alias: `buzz`) for those
# families. Do not point Hermes native `anthropic` at Buzz.
# Seed registers this as providers.buzz (key_env: BUZZ_API_KEY).
BUZZ_API_KEY=

# ── Dashboard: keep off ─────────────────────────────────────────────────────
# Official Docker docs: HERMES_DASHBOARD=1/true/yes enables the public
# dashboard on 9119. Leave 0 / unset. Do not use marketplace templates
# that turn the dashboard on.
HERMES_DASHBOARD=0

# ── First boot on a blank volume ────────────────────────────────────────────
# Official env. Without this, s6 registers gateway-default down on an
# empty /opt/data (no gateway_state.json) and /health never comes up.
HERMES_GATEWAY_BOOTSTRAP_STATE=running

# ── Railway builder (required for new services) ─────────────────────────────
# Config as Code (railway.toml) is ignored for new Railway services.
# Set this *before* the first deploy so Railpack does not build Next.js.
RAILWAY_DOCKERFILE_PATH=deploy/hermes/Dockerfile

# Optional: healthcheck wait (seconds). Official image + first-boot seed
# can take a while. Railway default is 300.
# RAILWAY_HEALTHCHECK_TIMEOUT_SEC=300

# ── Do not set ──────────────────────────────────────────────────────────────
# API_SERVER_CORS_ORIGINS=*     # Aether is server-to-server only
# HERMES_DASHBOARD=1            # public dashboard is a security risk
# TELEGRAM_BOT_TOKEN=           # messaging platforms stay off
# DISCORD_BOT_TOKEN=
# (and any other chat-platform tokens — do not invent extra keys)
# Do not mount /var/run/docker.sock — terminal is container-local.
